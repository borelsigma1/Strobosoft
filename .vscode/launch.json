{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Strobosoft starten",
            "type": "debugpy",
            "request": "launch",
            "module": "strobosoft",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
